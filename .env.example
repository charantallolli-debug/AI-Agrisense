# Copy to .env and fill in values (never commit .env)

FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# Optional — LLM treatment plans & farmer chatbot (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — OpenWeatherMap (if unset, live weather uses free Open-Meteo, no key needed)
OPENWEATHER_API_KEY=

# Inference: average original + flipped image for better accuracy
ENABLE_TTA=true
